GROQ_API_KEY=your_groq_api_key_here
# Preferred names; on startup KaamLink auto-falls back to models your key can access
GROQ_LLM_MODEL=llama-3.3-70b-versatile
GROQ_FAST_MODEL=llama-3.1-8b-instant
GROQ_STT_MODEL=whisper-large-v3
DATABASE_URL=sqlite:///./kaamlink.db
ALERT_TIMEOUT_SECONDS=60
DEMO_MODE=false
ENABLE_TWILIO=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
CORS_ORIGINS=*
AUTO_SEED=true
PORT=8000
